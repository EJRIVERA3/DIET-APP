{
  // Root deploy config for your OWN Cloudflare account (full app + cloud sync).
  // It deploys the already-built worker in dist/ — run `npm run build` first.
  //
  // One-time setup:
  //   1. npx wrangler login
  //   2. npx wrangler d1 create daily-diet-cloud-db
  //   3. paste the returned database_id below
  //   4. npm run deploy:cf
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daily-diet-cloud",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  // The worker bundle in dist/server is already built; don't re-bundle it.
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "assets": {
    "directory": "dist/client"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daily-diet-cloud-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
